    "googleTestAdapter.testDiscovery.traits.traitsRegexesBefore": {
      "type": "string",
      "title": "Before test discovery",
      "description": "Allows to override/add traits for testcases matching a regex. Traits are build up in 3 phases: 1st, traits are assigned to tests according to the 'Before test discovery' option. 2nd, the tests' traits (defined via the macros in GTA_Traits.h) are added to the tests, overriding traits from phase 1 with new values. 3rd, the 'After test discovery' option is evaluated, again in an overriding manner.\nSyntax: /// separates the regex from the traits, the trait's name and value are separated by , and each pair of regex and trait is separated by //||//.\nExample: MySuite\\.*///Type,Small//||//MySuite2\\.*|MySuite3\\.*///Type,Medium",
      "default": "",
      "transientScopesSupported": false,
      "order": 0,
      "migration": {
        "pass": {
          "input": {
            "store": "SettingsManager",
            "path": "GoogleTestAdapter.VsPackage.OptionsPages.TestDiscoveryOptionsDialogPage.TraitsRegexesBefore"
          },
          "mode": "full"
        }
      }
    },
    "googleTestAdapter.testDiscovery.traits.traitsRegexesAfter": {
      "type": "string",
      "title": "After test discovery",
